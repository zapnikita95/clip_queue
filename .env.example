# Clip Queue — separate service (not Movie Planner)
SECRET_KEY=change-me-in-prod
DATABASE_URL=sqlite:///./data/clip_queue.db
# On Railway: postgres://... (set automatically if you attach Postgres)

# Dev login: magic link code printed to server logs; or use fixed bypass
DEV_LOGIN=1
DEV_EMAIL=dev@clipqueue.local

# Optional: richer metadata (duration, description). Without it oEmbed still works.
YOUTUBE_API_KEY=

# Public origin (Railway domain or custom)
PUBLIC_ORIGIN=http://127.0.0.1:8765
PORT=8765